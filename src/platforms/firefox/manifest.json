{
  "manifest_version": 3,
  "name": "__buildName__",
  "description": "__MSG_extDescription__",
  "author": "Philip Lawrence, Modified by fany0r",
  "version": "__buildVersion__",
  "browser_specific_settings": {
    "gecko": {
      "id": "{f64d4986-57d5-4f37-b060-b2356bd96ac5}",
      "strict_min_version": "58.0"
    }
  },
  "background": {
    "service_worker": "serviceWorker.js",
    "scripts": ["serviceWorker.js"],
    "type": "module"
  },
  "default_locale": "en",
  "action": {
    "default_icon": {
      "16": "assets/logo-16-bw.png",
      "32": "assets/logo-32-bw.png",
      "38": "assets/logo-38-bw.png"
    },
    "default_popup": "action.html"
  },
  "icons": {
    "32": "assets/logo-32.png",
    "38": "assets/logo-38.png",
    "64": "assets/logo-64.png",
    "128": "assets/logo-128.png"
  },
  "homepage_url": "__homePage__",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
